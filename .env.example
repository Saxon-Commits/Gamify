# ==========================
# Environment Variables Example
# ==========================
# Copy this file to .env.local and fill in your values
# NEVER commit real secrets to git!

# Gemini AI (optional)
GEMINI_API_KEY=your_gemini_api_key

# Convex Deployment
CONVEX_DEPLOYMENT=dev:your-deployment-name # team: your-team, project: your-project
VITE_CONVEX_URL=https://your-project.convex.cloud

# Clerk Authentication (Publishable key - safe for client)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Stripe Payment (DANGEROUS - DO NOT COMMIT REAL VALUES!)
# For production: Add STRIPE_KEY to Convex Dashboard → Settings → Environment Variables
# STRIPE_KEY=sk_test_xxxxx  # ← NEVER commit this line with real values
